TEAM_ID=

PRODUCT_NAME=Turf Mobile
PRODUCT_BUNDLE_IDENTIFIER=com.xyz.netmobile.NetmobileIOS$(TEAM_ID)

CURRENT_PROJECT_VERSION=5
MARKETING_VERSION=5.0.0

// 适配模拟器构建：指向 iosSimulatorArm64 目录
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(SRCROOT)/../shared/build/bin/iosSimulatorArm64/releaseFramework"
OTHER_LDFLAGS = $(inherited) -framework Shared -ObjC
SWIFT_INCLUDE_PATHS = $(inherited) "$(SRCROOT)/../shared/build/bin/iosSimulatorArm64/releaseFramework"
